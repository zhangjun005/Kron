{
  "name": "kron-vscode",
  "displayName": "Kron",
  "description": "Kron language support",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kron.refreshIntents",
        "title": "Kron: Refresh Intents"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kron.refreshIntents",
          "when": "view == kron.intents",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "kron.intents",
          "name": "Kron Intents"
        }
      ]
    },
    "configuration": {
      "title": "Kron",
      "properties": {
        "kron.serverPath": {
          "type": "string",
          "default": "kron",
          "description": "Path to the Kron executable. Set an absolute path when kron is not on the extension host PATH."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "vscode-languageclient": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
