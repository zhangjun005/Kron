{
  "name": "kron-vscode",
  "displayName": "Kron",
  "publisher": "homofluctus",
  "description": "Kron language support",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangjun005/Kron.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kron.refreshIntents",
        "title": "Kron: Refresh Intents"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kron.refreshIntents",
          "when": "view == kron.intents",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "kron.intents",
          "name": "Kron Intents"
        }
      ]
    },
    "configuration": {
      "title": "Kron",
      "properties": {
        "kron.serverPath": {
          "type": "string",
          "default": "kron",
          "description": "Path to the Kron executable. Set an absolute path when kron is not on the extension host PATH."
        },
        "kron.lspLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "go",
            "markdown",
            "typescript",
            "javascript",
            "python",
            "rust",
            "java",
            "c",
            "cpp",
            "csharp",
            "kotlin",
            "swift",
            "shellscript"
          ],
          "description": "VSCode language IDs that receive Kron hover and definition support."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "vscode-languageclient": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
