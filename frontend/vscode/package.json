{
  "name": "kron-vscode",
  "type": "commonjs",
  "displayName": "Kron",
  "publisher": "zhangjun005",
  "description": "Kron intent ledger for VS Code: browse intent trees, inspect assumptions and jump through code anchors — backed by the kron MCP/LSP servers.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangjun005/Kron.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.kron/**",
    "onView:kron.intents",
    "onView:kron.intentsSidebar",
    "onView:kron.assumptions",
    "onView:kron.superseded"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kron.refreshIntents",
        "title": "Kron: Refresh Intents",
        "icon": "$(refresh)"
      },
      {
        "command": "kron.openIntentWorkspace",
        "title": "Kron: Open Intent Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "kron.restartConnections",
        "title": "Kron: Restart Connections",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kron.openIntentDetails",
        "title": "Kron: Open Intent Details"
      },
      {
        "command": "kron.editIntentFromAnchor",
        "title": "Kron: Edit Intent"
      },
      {
        "command": "kron.openIntentMarkdown",
        "title": "Kron: Open Intent Markdown"
      },
      {
        "command": "kron.showIntentImpact",
        "title": "Kron: Show Intent Impact"
      },
      {
        "command": "kron.changeAnchorTarget",
        "title": "Kron: Change Anchor Target"
      },
      {
        "command": "kron.createIntentForAnchor",
        "title": "Kron: Create Intent for Anchor"
      },
      {
        "command": "kron.createIntentAndAttachAnchor",
        "title": "Kron: Create Intent and Attach Anchor"
      },
      {
        "command": "kron.attachExistingIntentAnchor",
        "title": "Kron: Attach Existing Intent Anchor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kron.refreshIntents",
          "when": "view =~ /^kron\\.(intents|intentsSidebar|assumptions|superseded)$/",
          "group": "navigation"
        },
        {
          "command": "kron.openIntentWorkspace",
          "when": "view =~ /^kron\\.(intents|intentsSidebar)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kron.openIntentDetails",
          "when": "resourceScheme == file && kronAnchorState == 'valid'",
          "group": "kron@1"
        },
        {
          "command": "kron.editIntentFromAnchor",
          "when": "resourceScheme == file && kronAnchorState == 'valid'",
          "group": "kron@2"
        },
        {
          "command": "kron.openIntentMarkdown",
          "when": "resourceScheme == file && kronAnchorState == 'valid'",
          "group": "kron@3"
        },
        {
          "command": "kron.showIntentImpact",
          "when": "resourceScheme == file && kronAnchorState == 'valid'",
          "group": "kron@4"
        },
        {
          "command": "kron.changeAnchorTarget",
          "when": "(resourceScheme == file) && (kronAnchorState == 'valid' || kronAnchorState == 'dangling')",
          "group": "kron@5"
        },
        {
          "command": "kron.createIntentForAnchor",
          "when": "(resourceScheme == file) && (kronAnchorState == 'dangling')",
          "group": "kron@6"
        },
        {
          "command": "kron.createIntentAndAttachAnchor",
          "when": "(resourceScheme == file) && (kronAnchorState == 'none')",
          "group": "kron@8"
        },
        {
          "command": "kron.attachExistingIntentAnchor",
          "when": "(resourceScheme == file) && (kronAnchorState == 'none')",
          "group": "kron@9"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "kron.intents",
          "name": "Kron Intents",
          "when": "config.kron.sidebar.explorer"
        }
      ],
      "kron": [
        {
          "id": "kron.intentsSidebar",
          "name": "Intents",
          "when": "config.kron.sidebar.independent",
          "icon": "$(list-tree)"
        },
        {
          "id": "kron.assumptions",
          "name": "Assumptions",
          "when": "config.kron.sidebar.independent",
          "icon": "$(symbol-constant)"
        },
        {
          "id": "kron.superseded",
          "name": "Superseded",
          "when": "config.kron.sidebar.independent",
          "icon": "$(history)"
        }
      ]
    },
    "configuration": {
      "title": "Kron",
      "properties": {
        "kron.serverPath": {
          "type": "string",
          "default": "kron",
          "description": "Path to the Kron executable. Set an absolute path when kron is not on the extension host PATH."
        },
        "kron.webviewFontSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 24,
          "default": 14,
          "description": "Base font size in the Kron Intent Workspace Webview."
        },
        "kron.sidebar.independent": {
          "type": "boolean",
          "default": true,
          "description": "Show the Kron intents view in the dedicated Kron Activity Bar sidebar."
        },
        "kron.sidebar.explorer": {
          "type": "boolean",
          "default": false,
          "description": "Also show the Kron intents view in the Explorer sidebar. Both sidebar options can be enabled or disabled independently."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kron",
          "title": "Kron",
          "icon": "media/kron.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kron.intents",
        "contents": "No `.kron/` project in this workspace.\n\n[Open Kron workspace](command:kron.openIntentWorkspace) · [Restart connections](command:kron.restartConnections)",
        "when": "!kronHasProject"
      },
      {
        "view": "kron.intentsSidebar",
        "contents": "No `.kron/` project in this workspace.\n\nOpen a folder containing a `.kron/` directory, then run **Kron: Restart Connections**.\n\n[Open Kron workspace](command:kron.openIntentWorkspace) · [Restart connections](command:kron.restartConnections)",
        "when": "!kronHasProject"
      },
      {
        "view": "kron.assumptions",
        "contents": "No assumption registry loaded.\n\nAssumptions live in `.kron/assumptions/`. [Refresh](command:kron.refreshIntents)",
        "when": "!kronHasProject"
      },
      {
        "view": "kron.superseded",
        "contents": "No superseded intents.",
        "when": "!kronHasProject"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "package": "vsce package --dependencies",
    "build:webview": "pnpm --dir webview build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "vscode-languageclient": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "icon": "media/kronLogo.png",
  "author": "zhangjun005, HomoFluctus, lanyue811",
  "homepage": "https://github.com/zhangjun005/Kron",
  "bugs": {
    "url": "https://github.com/zhangjun005/Kron/issues"
  },
  "keywords": [
    "kron",
    "intent",
    "assumptions",
    "knowledge-base",
    "ai-agents",
    "mcp",
    "lsp"
  ],
  "license": "MIT"
}
