{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kron Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "Kron: build extension and webview"
    }
  ]
}
