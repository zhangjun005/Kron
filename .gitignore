# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test
*.out

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Project-specific
.kron/
# …except the committed integration fixture. Other modules (GUI / MCP / LSP /
# CLI tests) share this project, so its .kron data must be versioned.
!testdata/kron-project/.kron/
!testdata/kron-project/.kron/**
KRON/.kron-context/
kron-internal/

# E2E MCP test workspace — external L3 driver (not a Go test package),
# the kron binary it ships, and the project fixture it builds. None of
# these are checked in: regenerated by `kron-mcp-test/setup.sh` from the
# current HEAD of this repo. See kron-mcp-test/README.md for layout.
kron-mcp-test/

# Frontend build outputs
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/vscode/out/
frontend/vscode/node_modules/
frontend/wails/node_modules/
frontend/wails/dist/
frontend/wails/.vite/
frontend/wails/frontend/*.md5
# frontend/wails/build/bin/ is covered by frontend/wails/.gitignore; the rest of
# build/ (icons, plists, NSIS scripts) is source and stays tracked.

# Rust legacy (will be cleaned from archive branch if needed)
# Uncomment if rebuilding Rust side:
# src-tauri/target/
# target/

# Temporary commit messages written by automated agent sessions
.cursor/commit-msg-*.txt

# Soft-deleted documents (moved to .deprecated/<date>-<reason>/ for audit;
# restore with `git mv .deprecated/<date>-<reason>/<file> <original-path>`).
# DO NOT git add files inside .deprecated/ — they're archived, not live.
.deprecated/

# Personal dev-log: junction (Windows dir link) to d:\cursor\kron-dev-log\.
# Content lives outside the repo (independent git); junction is just a
# convenient in-repo mount so the developer (and reviewers) can find it
# from the Kron tree. Files belong to the *external* dev-log, not here.
dev-log/

# Accidental redirect output (e.g. `cmd > dev/null` mistake on PowerShell
# creates a literal dev/null file; not the Unix /dev/null device).
dev/null

# D end-to-end test fixture (serve-lsp manual verification):
# contains a minimal Kron repo (intents + source files) used by
# cmd/kron-d-test/ to verify the LSP driver wires correctly.
# The driver itself (cmd/kron-d-test/) IS committed; only this
# throwaway repo fixture is ignored.
.d-test/
