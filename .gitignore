frontend/wails/frontend/*.md5

# Rust legacy (will be cleaned from archive branch if needed)
# Uncomment if rebuilding Rust side:
# src-tauri/target/
# target/

# Temporary commit messages written by automated agent sessions
.cursor/commit-msg-*.txt

# Soft-deleted documents (moved to .deprecated/<date>-<reason>/ for audit;
# restore with `git mv .deprecated/<date>-<reason>/<file> <original-path>`).
# DO NOT git add files inside .deprecated/ — they're archived, not live.
.deprecated/

# Personal dev-log: junction (Windows dir link) to d:\cursor\kron-dev-log\.
# Content lives outside the repo (independent git); junction is just a
# convenient in-repo mount so the developer (and reviewers) can find it
# from the Kron tree. Files belong to the *external* dev-log, not here.
dev-log/

# Accidental redirect output (e.g. `cmd > dev/null` mistake on PowerShell
# creates a literal dev/null file; not the Unix /dev/null device).
dev/null
