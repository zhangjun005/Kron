# Rust build artifacts
/target/
**/*.rs.bk
Cargo.lock

# Kron internal state (NEVER commit)
/.kron/
/kron-internal/
/KRON/           # test artifacts from `kron init`
KRON/.kron-context/  # AI context snapshots (auto-generated, rebuild anytime)

# Local scratch project (used for end-to-end CLI testing)
/testProject/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp
*.tmp
*.temp

# Node (not used by Kron, but in case)
node_modules/

# Tauri 2 + Solid frontend
/src-tauri/target/
/frontend/dist/
/frontend/node_modules/
/frontend/.vite/

# Tauri generated icons (regenerated by `cargo tauri icon`)
/src-tauri/icons/*.png
/src-tauri/icons/*.ico
/src-tauri/icons/*.icns
!/src-tauri/icons/.gitkeep

# Tauri build-generated schemas (regenerated by `cargo tauri dev/build`)
/src-tauri/gen/schemas/
/src-tauri/gen/schemas/*.json

# Vite build artifacts
/frontend/dist/*
!/frontend/dist/.gitkeep
